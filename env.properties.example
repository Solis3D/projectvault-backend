PORT=8080

DB_URL=jdbc:postgresql://localhost:5432/projectvault
DB_USERNAME=postgres
DB_PASSWORD=change-me
DDL_AUTO=update
SHOW_SQL=false

JWT_SECRET=replace-with-a-random-secret-key-of-at-least-32-characters
JWT_EXPIRATION=86400000

CLOUDINARY_CLOUD_NAME=your-cloud-name
